# CA Tool root CA directory (private)
embed-root-ca/

# Standalone tools repo (managed separately at pqctoday/pqctoday-sdk)
tools/
# ...but allow Business Center tool components (same dir name, different purpose)
!src/components/BusinessCenter/tools/

# Local enrichment workspace (CSVs, HTML/PDF cache, scripts — private dev only)
src/cowork/

# PKI keys — certs are committed (trust anchors), keys never are
pki/ca/keys/
pki/vendors/keys/
pki/issued/
# Allow PKI cert PEMs (overrides *.pem above) — bundled by Vite as trust anchors
!pki/ca/*.pem
!pki/vendors/*.pem
src/.!*!.DS_Store

# Capture-integrity guard — npm run audit:capture-integrity, plus its
# local-gate suite. Referenced by a committed package.json script, so it has
# the same `scripts/*` trap as every entry above: without these two negations
# `git add scripts/audit-capture-integrity.ts` is a SILENT no-op and the gate
# exists only on the machine that wrote it. Public input (public/*/manifest.json
# hashes, src/data/library_*.csv read-only), stdout output, no network unless
# --upstream is passed explicitly.
!scripts/audit-capture-integrity.ts
!scripts/audit-capture-integrity.local.test.ts
