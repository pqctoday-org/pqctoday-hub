<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      SYSLIB5006 is the "experimental post-quantum cryptography API" diagnostic.
      MLDsa carried it during the .NET 10 previews; it is suppressed explicitly
      so the sample builds the same on every .NET 10 SDK band.
    -->
    <NoWarn>$(NoWarn);SYSLIB5006</NoWarn>
  </PropertyGroup>
</Project>
