        {
          "id": "cloud",
          "kind": "cloud",
          "zone": "third"
        }
      ],
      "steps": [
        {
          "id": "generate-fhe-secret",
          "from": "hsm",
          "to": "hsm",
          "phase": "setup",
          "data": "keys",
          "deployment": true,
          "engineStatus": "refused",
          "api": "KeyGen()"
        },
        {
          "id": "export-evaluation-keys",
          "from": "hsm",
          "to": "cloud",
          "phase": "setup",
          "data": "keys",
          "deployment": true,
          "engineStatus": "refused",
          "api": "EvalMultKeyGen · EvalRotateKeyGen · EvalBootstrapKeyGen"
        },
        {
          "id": "publish-public-key",
          "from": "hsm",
          "to": "client",
          "phase": "setup",
          "data": "keys",
          "deployment": true,
          "engineStatus": "refused",
          "api": "KeyGen() → publicKey"
        },
        {
          "id": "owner-encrypts-locally",
          "from": "client",
          "to": "client",
          "phase": "encrypt",
          "data": "encrypting",
          "deployment": false,
          "engineStatus": "outside",
          "api": "MakeCKKSPackedPlaintext · Encrypt"
        },
        {
          "id": "upload-ciphertexts",
          "from": "client",
          "to": "cloud",
          "phase": "encrypt",
          "data": "encrypted",
          "deployment": false,
          "engineStatus": "outside"
        },
        {
          "id": "compute-ciphertexts",
          "from": "cloud",
          "to": "cloud",
          "phase": "compute",
          "data": "encrypted",
          "deployment": false,
          "engineStatus": "outside",
          "api": "EvalAdd · EvalMult · EvalRotate · EvalBootstrap"
        },
        {
          "id": "return-encrypted-result",
          "from": "cloud",
          "to": "client",
          "phase": "compute",
          "data": "encrypted",
          "deployment": false,
          "engineStatus": "outside"
        },
        {
          "id": "owner-requests-decrypt",
          "from": "client",
          "to": "hsm",
          "phase": "decrypt",
          "data": "encrypted",
          "deployment": false,
          "engineStatus": "refused"
        },
        {
          "id": "decrypt-under-policy",
          "from": "hsm",
          "to": "hsm",
          "phase": "decrypt",
          "data": "decrypting",
          "deployment": true,
          "engineStatus": "refused",
          "api": "Decrypt with DecryptionNoiseMode NOISE_FLOODING_DECRYPT"
        },
        {
          "id": "release-result",
          "from": "hsm",
          "to": "client",
          "phase": "decrypt",
          "data": "result",
          "deployment": false,
          "engineStatus": "refused"
        },
        {
          "id": "live-clone-peer-hsm",
          "from": "hsm",
          "to": "dr",
          "phase": "backup",
          "data": "keys",
          "deployment": true,
          "engineStatus": "refused",
          "api": "vendor replication capability: live clone (planned; names fixed in P0B)"
        },
        {
          "id": "offline-backup-restore",
          "from": "hsm",
          "to": "dr",
          "phase": "backup",
          "data": "keys",
          "deployment": true,
          "engineStatus": "refused",
          "api": "vendor replication capability: offline backup package, restored by the enrolled backup HSM (planned)"
        }
