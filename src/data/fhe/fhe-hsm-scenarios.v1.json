          "id": "hsmA",
          "kind": "hsm",
          "zone": "party"
        },
        {
          "id": "hsmB",
          "kind": "hsm",
          "zone": "party"
        },
        {
          "id": "hsmC",
          "kind": "hsm",
          "zone": "party"
        }
      ],
      "steps": [
        {
          "id": "party-a-keygen",
          "from": "hsmA",
          "to": "hsmA",
          "phase": "setup",
          "data": "keys",
          "deployment": true,
          "api": "KeyGen()"
        },
        {
          "id": "party-b-multiparty-keygen",
          "from": "hsmA",
          "to": "hsmB",
          "phase": "setup",
          "data": "keys",
          "deployment": false,
          "api": "MultipartyKeyGen(pk₁)"
        },
        {
          "id": "party-c-multiparty-keygen",
          "from": "hsmB",
          "to": "hsmC",
          "phase": "setup",
          "data": "keys",
          "deployment": false,
          "api": "MultipartyKeyGen(pk₁₂)"
        },
        {
          "id": "build-joint-relinearization-key",
          "from": "hsmA",
          "to": "hsmC",
          "phase": "setup",
          "data": "keys",
          "deployment": false,
          "api": "KeySwitchGen · MultiKeySwitchGen · MultiAddEvalKeys · MultiMultEvalKey · MultiAddEvalMultKeys"
        },
        {
          "id": "publish-eval-keys",
          "from": "hsmC",
          "to": "cloud",
          "phase": "setup",
          "data": "keys",
          "deployment": false,
          "api": "EvalSumKeyGen · MultiEvalSumKeyGen · MultiAddEvalSumKeys"
        },
        {
          "id": "owner-encrypts-locally",
          "from": "client",
          "to": "client",
          "phase": "encrypt",
          "data": "encrypting",
          "deployment": false,
          "api": "Encrypt(jointPublicKey, plaintext)"
        },
        {
          "id": "upload-ciphertexts",
          "from": "client",
          "to": "cloud",
          "phase": "encrypt",
          "data": "encrypted",
          "deployment": false
        },
        {
          "id": "compute-ciphertexts",
          "from": "cloud",
          "to": "cloud",
          "phase": "compute",
          "data": "encrypted",
          "deployment": false,
          "api": "EvalAdd · EvalMult · EvalSum"
        },
        {
          "id": "return-encrypted-result",
          "from": "cloud",
          "to": "client",
          "phase": "compute",
          "data": "encrypted",
          "deployment": false
        },
        {
          "id": "owner-requests-partials",
          "from": "client",
          "to": "hsmC",
          "phase": "decrypt",
          "data": "encrypted",
          "deployment": false
