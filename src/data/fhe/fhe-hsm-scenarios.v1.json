        {
          "id": "client",
          "kind": "client",
          "zone": "owner"
        },
        {
          "id": "hsm",
          "kind": "hsm",
          "zone": "owner"
        },
        {
          "id": "dr",
          "kind": "hsm",
          "zone": "owner"
