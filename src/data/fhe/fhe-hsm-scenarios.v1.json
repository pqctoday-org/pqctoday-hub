{
  "schema": "fhe-hsm-scenarios.v1",
  "description": "Canonical FHE + HSM scenario contract (owner decision 2026-10-03). Stable scenario and step ids for the Hub workshop, evidence records (fhe-evidence.v1) and the producers pqctoday-sandbox, pqctoday-fhe (KV260) and pqctoday-cacp (MX95, MX95 Pro). Ids are never reused or renamed; a changed step gets a new id.",
  "scenarios": [
    {
      "id": "single-hsm",
      "label": "CKKS single-HSM custody",
      "scheme": "CKKS",
      "baseline": {
        "implementation": "OpenFHE CKKS (KeyGen, EvalMultKeyGen, EvalRotateKeyGen, EvalBootstrapKeyGen, NOISE_FLOODING_DECRYPT)",
        "codeUrl": "https://github.com/openfheorg/openfhe-development/tree/v1.6.0",
        "paper": "Cheon, Kim, Kim, Song: Homomorphic Encryption for Arithmetic of Approximate Numbers (ASIACRYPT 2017); OpenFHE design paper (IACR ePrint 2022/915)",
        "paperUrl": "https://eprint.iacr.org/2022/915"
      },
      "validationTarget": "Reference only: evaluation-key sizes measured with OpenFHE CKKS. The planned engine refuses the evaluation-key export by design.",
      "actors": [
        {
          "id": "client",
          "kind": "client",
          "zone": "owner"
        },
        {
          "id": "hsm",
          "kind": "hsm",
          "zone": "owner"
        },
        {
          "id": "dr",
          "kind": "hsm",
          "zone": "owner"
        },
        {
          "id": "cloud",
          "kind": "cloud",
          "zone": "third"
        }
      ],
      "steps": [
        {
          "id": "generate-fhe-secret",
          "from": "hsm",
          "to": "hsm",
          "phase": "setup",
          "data": "keys",
          "deployment": true,
          "api": "KeyGen()"
        },
        {
          "id": "export-evaluation-keys",
          "from": "hsm",
          "to": "cloud",
          "phase": "setup",
          "data": "keys",
          "deployment": true,
          "api": "EvalMultKeyGen · EvalRotateKeyGen · EvalBootstrapKeyGen"
        },
        {
          "id": "publish-public-key",
          "from": "hsm",
          "to": "client",
          "phase": "setup",
          "data": "keys",
          "deployment": true,
          "api": "KeyGen() → publicKey"
        },
        {
          "id": "owner-encrypts-locally",
          "from": "client",
          "to": "client",
          "phase": "encrypt",
          "data": "encrypting",
          "deployment": false,
          "api": "MakeCKKSPackedPlaintext · Encrypt"
        },
        {
          "id": "upload-ciphertexts",
          "from": "client",
          "to": "cloud",
          "phase": "encrypt",
          "data": "encrypted",
          "deployment": false
        },
        {
          "id": "compute-ciphertexts",
          "from": "cloud",
          "to": "cloud",
          "phase": "compute",
          "data": "encrypted",
          "deployment": false,
          "api": "EvalAdd · EvalMult · EvalRotate · EvalBootstrap"
        },
        {
          "id": "return-encrypted-result",
          "from": "cloud",
          "to": "client",
          "phase": "compute",
          "data": "encrypted",
          "deployment": false
        },
        {
          "id": "owner-requests-decrypt",
          "from": "client",
          "to": "hsm",
          "phase": "decrypt",
          "data": "encrypted",
          "deployment": false
        },
        {
          "id": "decrypt-under-policy",
          "from": "hsm",
          "to": "hsm",
          "phase": "decrypt",
          "data": "decrypting",
          "deployment": true,
          "api": "Decrypt with DecryptionNoiseMode NOISE_FLOODING_DECRYPT"
        },
        {
          "id": "release-result",
          "from": "hsm",
          "to": "client",
          "phase": "decrypt",
          "data": "result",
          "deployment": false
        },
        {
          "id": "live-clone-peer-hsm",
          "from": "hsm",
          "to": "dr",
          "phase": "backup",
          "data": "keys",
          "deployment": true,
          "api": "vendor replication capability: live clone (planned; names fixed in P0B)"
        },
        {
          "id": "offline-backup-restore",
          "from": "hsm",
          "to": "dr",
          "phase": "backup",
          "data": "keys",
          "deployment": true,
          "api": "vendor replication capability: offline backup package, restored by the enrolled backup HSM (planned)"
        }
      ]
    },
    {
      "id": "tfhe-single-hsm",
      "label": "TFHE single-HSM custody",
      "scheme": "TFHE",
      "baseline": {
        "implementation": "TFHE-rs high-level API (ClientKey, CompressedServerKey, CompactPublicKey, FheUint)",
        "codeUrl": "https://github.com/zama-ai/tfhe-rs",
        "paper": "Chillotti, Gama, Georgieva, Izabachène: TFHE: Fast Fully Homomorphic Encryption over the Torus (Journal of Cryptology, 2020)",
        "paperUrl": "https://eprint.iacr.org/2018/421"
      },
      "validationTarget": "Token-validated: every HSM step through PKCS#11 v3.2 vendor mechanisms in pqctoday-hsm, plus reference-validated with TFHE-rs.",
      "actors": [
        {
          "id": "client",
          "kind": "client",
          "zone": "owner"
        },
        {
          "id": "hsm",
          "kind": "hsm",
          "zone": "owner"
        },
        {
          "id": "dr",
          "kind": "hsm",
          "zone": "owner"
        },
        {
          "id": "cloud",
          "kind": "cloud",
          "zone": "third"
        }
      ],
      "steps": [
        {
          "id": "generate-client-key",
          "from": "hsm",
          "to": "hsm",
          "phase": "setup",
          "data": "keys",
          "deployment": true,
          "api": "ClientKey::generate_with_seed(config, Seed)"
        },
        {
          "id": "generate-server-key",
          "from": "hsm",
          "to": "hsm",
          "phase": "setup",
          "data": "keys",
          "deployment": true,
          "api": "CompressedServerKey::new(&client_key)"
        },
        {
          "id": "export-server-key",
          "from": "hsm",
          "to": "cloud",
          "phase": "setup",
          "data": "keys",
          "deployment": true,
          "api": "CompressedServerKey → decompress() on the server"
        },
        {
          "id": "publish-compact-public-key",
          "from": "hsm",
          "to": "client",
          "phase": "setup",
          "data": "keys",
          "deployment": true,
          "api": "CompactPublicKey::new(&client_key)"
        },
        {
          "id": "owner-encrypts-locally",
          "from": "client",
          "to": "client",
          "phase": "encrypt",
          "data": "encrypting",
          "deployment": false,
          "api": "CompactCiphertextList::builder(&public_key)"
        },
        {
          "id": "upload-ciphertexts",
          "from": "client",
          "to": "cloud",
          "phase": "encrypt",
          "data": "encrypted",
          "deployment": false
        },
        {
          "id": "compute-with-pbs",
          "from": "cloud",
          "to": "cloud",
          "phase": "compute",
          "data": "encrypted",
          "deployment": false,
          "api": "set_server_key · FheUint64 arithmetic and comparisons"
        },
        {
          "id": "return-encrypted-result",
          "from": "cloud",
          "to": "client",
          "phase": "compute",
          "data": "encrypted",
          "deployment": false
        },
        {
          "id": "owner-requests-decrypt",
          "from": "client",
          "to": "hsm",
          "phase": "decrypt",
          "data": "encrypted",
          "deployment": false
        },
        {
          "id": "decrypt-under-policy",
          "from": "hsm",
          "to": "hsm",
          "phase": "decrypt",
          "data": "decrypting",
          "deployment": true,
          "api": "FheUint64::decrypt(&client_key)"
        },
        {
          "id": "release-result",
          "from": "hsm",
          "to": "client",
          "phase": "decrypt",
          "data": "result",
          "deployment": false
        },
        {
          "id": "live-clone-peer-hsm",
          "from": "hsm",
          "to": "dr",
          "phase": "backup",
          "data": "keys",
          "deployment": true,
          "api": "vendor replication capability: live clone (planned; names fixed in P0B)"
        },
        {
          "id": "offline-backup-restore",
          "from": "hsm",
          "to": "dr",
          "phase": "backup",
          "data": "keys",
          "deployment": true,
          "api": "vendor replication capability: offline backup package, restored by the enrolled backup HSM (planned)"
        }
      ]
    },
    {
      "id": "openfhe-threshold",
      "label": "Threshold: OpenFHE BFV (3-of-3)",
      "scheme": "BFV",
      "baseline": {
        "implementation": "OpenFHE threshold FHE, BFV run of src/pke/examples/threshold-fhe.cpp (2 parties), extended to 3 parties as in threshold-fhe-5p.cpp: MultipartyKeyGen, MultiKeySwitchGen, MultiAddEvalKeys, MultiMultEvalKey, MultiAddEvalMultKeys, MultiEvalSumKeyGen, MultipartyDecryptLead / Main / Fusion",
        "codeUrl": "https://github.com/openfheorg/openfhe-development/blob/v1.6.0/src/pke/examples/threshold-fhe.cpp",
        "paper": "OpenFHE design paper (IACR ePrint 2022/915), threshold FHE extension",
        "paperUrl": "https://eprint.iacr.org/2022/915"
      },
      "validationTarget": "Reference-validated with OpenFHE BFV. A PKCS#11 path through a Rust BFV backend (fhe.rs multiparty) only if its feasibility and independent-review gates pass.",
      "actors": [
        {
          "id": "client",
          "kind": "client",
          "zone": "owner"
        },
        {
          "id": "cloud",
          "kind": "cloud",
          "zone": "third"
        },
