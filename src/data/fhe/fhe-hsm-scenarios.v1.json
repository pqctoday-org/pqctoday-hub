      "id": "lattigo-threshold",
      "label": "Threshold: Lattigo BGV (2-of-3)",
      "scheme": "BGV",
      "baseline": {
        "implementation": "Lattigo v6.2.0 multiparty + mpbgv over schemes/bgv (one implementation of BGV and BFV): Thresholdizer / Combiner, PublicKeyGenProtocol, RelinearizationKeyGenProtocol, GaloisKeyGenProtocol, mpbgv.RefreshProtocol, PublicKeySwitchProtocol",
        "codeUrl": "https://pkg.go.dev/github.com/tuneinsight/lattigo/v6/multiparty",
        "paper": "Mouchet, Troncoso-Pastoriza, Bossuat, Hubaux: Multiparty Homomorphic Encryption from Ring-Learning-with-Errors (PoPETs 2021)",
        "paperUrl": "https://petsymposium.org/popets/2021/popets-2021-0071.php"
      },
      "validationTarget": "Token-validated through a Rust port of Lattigo’s protocols behind PKCS#11 v3.2 vendor mechanisms, only if its feasibility and review gates pass. The port is tested against Lattigo itself in Go (byte-exact fixtures, mixed Rust and Go parties) and needs an independent review.",
      "actors": [
        {
          "id": "client",
          "kind": "client",
          "zone": "owner"
        },
        {
          "id": "cloud",
          "kind": "cloud",
          "zone": "third"
        },
        {
          "id": "hsmA",
          "kind": "hsm",
          "zone": "party"
        },
        {
          "id": "hsmB",
          "kind": "hsm",
          "zone": "party"
        },
        {
          "id": "hsmC",
          "kind": "hsm",
          "zone": "party"
        }
      ],
      "steps": [
        {
          "id": "shamir-share-secret",
          "from": "hsmA",
          "to": "hsmC",
          "phase": "setup",
          "data": "keys",
          "deployment": false,
          "api": "Thresholdizer.GenShamirPolynomial · GenShamirSecretShare · Combiner.GenAdditiveShare"
        },
        {
          "id": "collective-public-key",
          "from": "hsmA",
          "to": "cloud",
          "phase": "setup",
          "data": "keys",
          "deployment": false,
          "api": "PublicKeyGenProtocol.GenShare · AggregateShares · GenPublicKey"
        },
        {
          "id": "collective-relinearization-key",
          "from": "hsmB",
          "to": "cloud",
          "phase": "setup",
          "data": "keys",
          "deployment": false,
          "api": "RelinearizationKeyGenProtocol (round 1 + round 2)"
        },
        {
          "id": "collective-galois-keys",
          "from": "hsmC",
          "to": "cloud",
          "phase": "setup",
          "data": "keys",
          "deployment": false,
          "api": "GaloisKeyGenProtocol (one run per automorphism)"
        },
        {
          "id": "owner-encrypts-locally",
          "from": "client",
          "to": "client",
          "phase": "encrypt",
          "data": "encrypting",
          "deployment": false,
          "api": "rlwe Encryptor (bgv.Parameters) with the collective public key"
        },
        {
          "id": "upload-ciphertexts",
          "from": "client",
          "to": "cloud",
          "phase": "encrypt",
          "data": "encrypted",
          "deployment": false
        },
        {
          "id": "compute-ciphertexts",
          "from": "cloud",
          "to": "cloud",
          "phase": "compute",
          "data": "encrypted",
          "deployment": false,
          "api": "bgv Evaluator"
        },
        {
          "id": "interactive-refresh",
          "from": "cloud",
          "to": "hsmB",
          "phase": "compute",
          "data": "encrypted",
          "deployment": true,
          "api": "mpbgv.RefreshProtocol.GenShare (noise flooding set in NewRefreshProtocol)"
        },
        {
          "id": "aggregate-refresh-shares",
          "from": "cloud",
          "to": "cloud",
          "phase": "compute",
          "data": "encrypted",
          "deployment": false,
          "api": "RefreshProtocol.AggregateShares · Finalize"
        },
        {
          "id": "key-switch-to-owner",
          "from": "hsmA",
          "to": "cloud",
          "phase": "decrypt",
          "data": "encrypted",
          "deployment": true,
          "api": "PublicKeySwitchProtocol.GenShare (target: owner public key)"
        },
        {
          "id": "deliver-result-to-owner",
          "from": "cloud",
          "to": "client",
          "phase": "decrypt",
          "data": "encrypted",
          "deployment": false,
          "api": "PublicKeySwitchProtocol.AggregateShares · KeySwitch"
        },
        {
          "id": "owner-decrypts-locally",
          "from": "client",
          "to": "client",
          "phase": "decrypt",
          "data": "decrypting",
          "deployment": false,
          "api": "rlwe Decryptor"
        }
      ]
