{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pqctoday.com/schemas/validation-case-manifest/1.0.0.json",
  "title": "ValidationCaseManifest",
  "$comment": "Machine contract for src/data/validation/vector-manifest.json (plan WS-B). Mirrored by validationCaseManifest.ts. The evidenceClass enum must equal EVIDENCE_CLASS_IDS in evidenceClasses.ts plus 'unverified' — scripts/audit-validation-manifest.ts fails on drift.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "vectorRoot", "files"],
  "properties": {
    "$schema": { "type": "string" },
    "$comment": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "vectorRoot": { "type": "string", "minLength": 1 },
    "files": { "type": "array", "items": { "$ref": "#/definitions/vectorFile" } }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "isoDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "evidenceClass": {
      "enum": [
        "nist-acvp-reference-sample",
        "acvts-issued-vector",
        "published-standard-kat",
        "independent-oracle",
        "cross-implementation-differential",
        "functional-round-trip",
        "oasis-profile-case",
        "product-mechanism-probe",
        "unverified"
      ]
    },
    "status": { "enum": ["active", "quarantined"] },
    "evidenceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url"],
      "properties": {
        "title": { "$ref": "#/definitions/nonEmpty" },
        "url": { "$ref": "#/definitions/nonEmpty" },
        "sha256": { "$ref": "#/definitions/sha256" },
        "retrieved": { "$ref": "#/definitions/isoDate" },
        "mirror": { "type": "boolean" },
        "localCopy": { "type": "string" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "method", "result", "evidence"],
      "properties": {
        "date": { "$ref": "#/definitions/isoDate" },
        "method": { "$ref": "#/definitions/nonEmpty" },
        "result": { "enum": ["match", "partial", "mismatch"] },
        "evidence": { "type": "array", "items": { "$ref": "#/definitions/evidenceDocument" } }
      }
    },
    "nistUpstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "upstreamPath", "upstreamSha256", "retrieved", "url"],
      "properties": {
        "repository": { "const": "https://github.com/usnistgov/ACVP-Server" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "upstreamPath": { "type": "string", "pattern": "^gen-val/json-files/[^/]+/[^/]+\\.json$" },
        "upstreamSha256": { "$ref": "#/definitions/sha256" },
        "retrieved": { "$ref": "#/definitions/isoDate" },
        "url": {
          "type": "string",
          "pattern": "^https://raw\\.githubusercontent\\.com/usnistgov/ACVP-Server/"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "citation"],
      "properties": {
        "kind": {
          "enum": [
            "nist-acvp-server",
            "published-document",
            "oracle-generated",
            "self-pinned-snapshot"
          ]
        },
        "citation": { "$ref": "#/definitions/nonEmpty" },
        "documentStatus": {
          "enum": [
            "nist-final-publication",
            "nist-example-set",
            "rfc",
            "internet-draft",
            "research-paper"
          ]
        },
        "url": { "type": ["string", "null"] },
        "revision": { "type": ["string", "null"] },
        "nist": { "$ref": "#/definitions/nistUpstream" },
        "oracle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "$ref": "#/definitions/nonEmpty" },
            "version": { "type": ["string", "null"] }
          }
        },
        "generator": { "type": "string" },
        "verification": { "$ref": "#/definitions/verification" }
      }
    },
    "caseRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "pointer",
        "algorithm",
        "operation",
        "parameters",
        "testType",
        "expectation"
      ],
      "properties": {
        "caseId": { "type": "string", "pattern": "^[a-z0-9_-]+#/.+$" },
        "pointer": { "type": "string", "pattern": "^/" },
        "algorithm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "revision"],
          "properties": {
            "name": { "$ref": "#/definitions/nonEmpty" },
            "revision": { "type": ["string", "null"] }
          }
        },
        "operation": { "$ref": "#/definitions/nonEmpty" },
        "parameters": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
        },
        "testType": { "$ref": "#/definitions/nonEmpty" },
        "expectation": { "enum": ["positive", "negative"] },
        "upstream": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tgId": { "type": "integer" },
            "tcId": { "type": "integer" },
            "label": { "type": "string" }
          }
        },
        "evidenceClass": { "$ref": "#/definitions/evidenceClass" },
        "status": { "$ref": "#/definitions/status" },
        "statusReason": { "type": "string" },
        "lineage": { "type": "array", "items": { "type": "string" } }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "quarantined" } }, "required": ["status"] },
          "then": { "required": ["statusReason"] }
        },
        {
          "if": {
            "properties": { "evidenceClass": { "const": "unverified" } },
            "required": ["evidenceClass"]
          },
          "then": {
            "required": ["status", "statusReason"],
            "properties": { "status": { "const": "quarantined" } }
          }
        }
      ]
    },
    "lineageRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "appliesTo", "upstreamOperation", "localOperation", "transformations"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "appliesTo": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "upstreamOperation": { "$ref": "#/definitions/nonEmpty" },
        "localOperation": { "$ref": "#/definitions/nonEmpty" },
        "transformations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "detail"],
            "properties": {
              "type": {
                "enum": [
                  "subset",
                  "renumber",
                  "field-rename",
                  "field-drop",
                  "field-add",
                  "value-normalize",
                  "operation-change",
                  "derived-within-file",
                  "inputs-modified-expected-recomputed",
                  "locally-generated"
                ]
              },
              "detail": { "$ref": "#/definitions/nonEmpty" }
            }
          }
        }
      }
    },
    "copyRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind"],
      "properties": {
        "path": { "$ref": "#/definitions/nonEmpty" },
        "kind": { "enum": ["byte-equal", "embedded-values", "shared-upstream-value"] },
        "cases": { "type": "array", "items": { "type": "string" } },
        "fields": { "type": "array", "items": { "type": "string" } },
        "note": { "type": "string" }
      },
      "if": {
        "properties": { "kind": { "enum": ["embedded-values", "shared-upstream-value"] } }
      },
      "then": { "required": ["cases", "fields"] }
    },
    "vectorFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256",
        "status",
        "evidenceClass",
        "source",
        "license",
        "caseContainers",
        "cases",
        "lineage",
        "copies",
        "publishabilityGaps"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "path": { "type": "string", "pattern": "^src/data/acvp/[^/]+\\.json$" },
        "sha256": { "$ref": "#/definitions/sha256" },
        "status": { "$ref": "#/definitions/status" },
        "statusReason": { "type": "string" },
        "evidenceClass": { "$ref": "#/definitions/evidenceClass" },
        "source": { "$ref": "#/definitions/source" },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["note", "reviewed"],
          "properties": {
            "note": { "$ref": "#/definitions/nonEmpty" },
            "reviewed": { "type": "boolean" }
          }
        },
        "caseContainers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pointer", "kind"],
            "properties": {
              "pointer": { "type": "string", "pattern": "^/" },
              "kind": { "enum": ["array", "map", "self"] }
            }
          }
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/caseRecord" }
        },
        "lineage": { "type": "array", "items": { "$ref": "#/definitions/lineageRecord" } },
        "copies": { "type": "array", "items": { "$ref": "#/definitions/copyRecord" } },
        "publishabilityGaps": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "oracle-version-not-recorded",
              "generator-script-not-in-repo",
              "source-document-hash-not-recorded",
              "retrieval-date-not-recorded"
            ]
          }
        },
        "inFileProvenanceConflict": {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "inFileValue", "reason"],
          "properties": {
            "field": { "$ref": "#/definitions/nonEmpty" },
            "inFileValue": { "type": "string" },
            "reason": { "$ref": "#/definitions/nonEmpty" }
          }
        },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "quarantined" } } },
          "then": { "required": ["statusReason"] }
        },
        {
          "if": { "properties": { "evidenceClass": { "const": "unverified" } } },
          "then": {
            "required": ["statusReason"],
            "properties": { "status": { "const": "quarantined" } }
          }
        },
        {
          "if": {
            "properties": { "evidenceClass": { "const": "nist-acvp-reference-sample" } }
          },
          "then": {
            "properties": {
              "source": {
                "required": ["nist"],
                "properties": { "kind": { "const": "nist-acvp-server" } }
              }
            }
          }
        },
        {
          "if": { "properties": { "evidenceClass": { "const": "independent-oracle" } } },
          "then": { "properties": { "source": { "required": ["oracle"] } } }
        }
      ]
    }
  }
}
