exports[`emitKmipPipeline — template snapshots > emits stable code for "Governed lifecycle" 1`] = `
""""Generated by the PQC Today hub's KMIP/CACP Developer tab pipeline builder.

Runs against the KMIP + crypto-agility policy engine through the pqctoday_kmip
client's real API surface — every operation crosses the CACP policy plane.
"""
import os
from pqctoday_kmip import KmipClient

c = KmipClient(os.environ.get('KMIP_HOST', 'pqc-kmip'), int(os.environ.get('KMIP_PORT', '5696')))

# ── create · ML-DSA-65 · createKeyPair ──
try:
    r_create = c.create_key_pair('ML_DSA_65', 'Sign Verify Encapsulate Decapsulate')
    priv_create = r_create.get('PrivateKeyUniqueIdentifier')
    pub_create = r_create.get('PublicKeyUniqueIdentifier')
    if not r_create.ok: raise RuntimeError(r_create.message or 'CreateKeyPair failed')
    print(f'  priv={priv_create}  pub={pub_create}')
    print('###STEP create ok###')
except Exception as _e:
    print('###STEP create error### %s: %s' % (type(_e).__name__, _e))
    raise

# ── sign-early · ML-DSA-65 · sign ──
try:
    r_sign_early = c.sign(priv_create, b'test payload', 'ML_DSA_65')
    print(f'  signature {len(r_sign_early.get("SignatureData") or "") // 2} bytes')
    print('###STEP sign-early ok###')
except Exception as _e:
    print('###STEP sign-early error### %s: %s' % (type(_e).__name__, _e))
    raise

# ── deny-early · Expect deny: sign-early ──
try:
    _denied = not r_sign_early.ok
    _reason = r_sign_early.get('ResultReason') or r_sign_early.get('ResultMessage') or 'denied'
    print(f'  expect-deny: {"refused (" + str(_reason) + ")" if _denied else "UNEXPECTEDLY ALLOWED — governance hole"}')
    if not _denied: raise RuntimeError('governance hole: operation was allowed when it should have been denied')
    print('###STEP deny-early ok###')
except Exception as _e:
    print('###STEP deny-early error### %s: %s' % (type(_e).__name__, _e))
    raise

# ── activate · ML-DSA-65 · activate ──
try:
    r_activate = c.activate(priv_create)
    if not r_activate.ok: raise RuntimeError(r_activate.message or 'Activate failed')
    print('###STEP activate ok###')
except Exception as _e:
    print('###STEP activate error### %s: %s' % (type(_e).__name__, _e))
    raise

# ── sign · ML-DSA-65 · sign ──
try:
    r_sign = c.sign(priv_create, b'test payload', 'ML_DSA_65')
    print(f'  signature {len(r_sign.get("SignatureData") or "") // 2} bytes')
    if not r_sign.ok: raise RuntimeError(r_sign.message or 'Sign failed')
    print('###STEP sign ok###')
except Exception as _e:
    print('###STEP sign error### %s: %s' % (type(_e).__name__, _e))
    raise

# ── attrs · ML-DSA-65 · getAttributes ──
try:
    r_attrs = c.get_attributes(priv_create)
    if not r_attrs.ok: raise RuntimeError(r_attrs.message or 'GetAttributes failed')
    print('###STEP attrs ok###')
except Exception as _e:
    print('###STEP attrs error### %s: %s' % (type(_e).__name__, _e))
    raise

# ── locate · ML-DSA-65 · locate ──
try:
    r_locate = c.locate()
    if not r_locate.ok: raise RuntimeError(r_locate.message or 'Locate failed')
    print('###STEP locate ok###')
except Exception as _e:
    print('###STEP locate error### %s: %s' % (type(_e).__name__, _e))
    raise

# ── revoke · ML-DSA-65 · revoke ──
try:
    r_revoke = c.revoke(priv_create)
    if not r_revoke.ok: raise RuntimeError(r_revoke.message or 'Revoke failed')
    print('###STEP revoke ok###')
except Exception as _e:
    print('###STEP revoke error### %s: %s' % (type(_e).__name__, _e))
    raise

# ── destroy · ML-DSA-65 · destroy ──
try:
    r_destroy = c.destroy(priv_create)
    if not r_destroy.ok: raise RuntimeError(r_destroy.message or 'Destroy failed')
    print('###STEP destroy ok###')
except Exception as _e:
    print('###STEP destroy error### %s: %s' % (type(_e).__name__, _e))
    raise
"
`;

exports[`emitKmipPipeline — template snapshots > emits stable code for "ML-KEM round trip" 1`] = `
""""Generated by the PQC Today hub's KMIP/CACP Developer tab pipeline builder.

Runs against the KMIP + crypto-agility policy engine through the pqctoday_kmip
client's real API surface — every operation crosses the CACP policy plane.
"""
import os
from pqctoday_kmip import KmipClient

c = KmipClient(os.environ.get('KMIP_HOST', 'pqc-kmip'), int(os.environ.get('KMIP_PORT', '5696')))

# ── create · ML-KEM-768 · createKeyPair ──
try:
    r_create = c.create_key_pair('ML_KEM_768', 'Sign Verify Encapsulate Decapsulate')
    priv_create = r_create.get('PrivateKeyUniqueIdentifier')
    pub_create = r_create.get('PublicKeyUniqueIdentifier')
    if not r_create.ok: raise RuntimeError(r_create.message or 'CreateKeyPair failed')
    print(f'  priv={priv_create}  pub={pub_create}')
    print('###STEP create ok###')
except Exception as _e:
    print('###STEP create error### %s: %s' % (type(_e).__name__, _e))
    raise

# ── activate-pub · ML-KEM-768 · activate ──
try:
    r_activate_pub = c.activate(pub_create)
    if not r_activate_pub.ok: raise RuntimeError(r_activate_pub.message or 'Activate failed')
    print('###STEP activate-pub ok###')
except Exception as _e:
    print('###STEP activate-pub error### %s: %s' % (type(_e).__name__, _e))
    raise

# ── activate-priv · ML-KEM-768 · activate ──
try:
    r_activate_priv = c.activate(priv_create)
    if not r_activate_priv.ok: raise RuntimeError(r_activate_priv.message or 'Activate failed')
    print('###STEP activate-priv ok###')
except Exception as _e:
    print('###STEP activate-priv error### %s: %s' % (type(_e).__name__, _e))
    raise

# ── encap · ML-KEM-768 · encapsulate ──
try:
    r_encap = c.encapsulate(pub_create)
    ct_encap = r_encap.get('Data')
    uid_encap = r_encap.get('UniqueIdentifier')
    if not r_encap.ok: raise RuntimeError(r_encap.message or 'Encapsulate failed')
    print(f'  ciphertext {len(ct_encap or "") // 2} bytes')
    print('###STEP encap ok###')
except Exception as _e:
    print('###STEP encap error### %s: %s' % (type(_e).__name__, _e))
    raise

# ── decap · ML-KEM-768 · decapsulate ──
try:
    r_decap = c.decapsulate(priv_create, bytes.fromhex(ct_encap))
    uid_decap = r_decap.get('UniqueIdentifier')
    if not r_decap.ok: raise RuntimeError(r_decap.message or 'Decapsulate failed')
    print('###STEP decap ok###')
except Exception as _e:
    print('###STEP decap error### %s: %s' % (type(_e).__name__, _e))
    raise
"
`;

exports[`emitKmipPipeline — template snapshots > emits stable code for "Policy dry-run compare" 1`] = `
""""Generated by the PQC Today hub's KMIP/CACP Developer tab pipeline builder.

Runs against the KMIP + crypto-agility policy engine through the pqctoday_kmip
client's real API surface — every operation crosses the CACP policy plane.
"""
import os
from pqctoday_kmip import KmipClient

c = KmipClient(os.environ.get('KMIP_HOST', 'pqc-kmip'), int(os.environ.get('KMIP_PORT', '5696')))

# ── load-permissive · Load policy: training-permissive.yaml ──
try:
    from pyodide.http import pyfetch
    _resp = await pyfetch('/kmip-policies/training-permissive.yaml')
    _yaml = await _resp.string()
    r_load_permissive = c.load_policy(_yaml)
    if not r_load_permissive.ok: raise RuntimeError(r_load_permissive.message or 'LoadPolicy failed')
    print('  policy loaded: training-permissive.yaml')
    print('###STEP load-permissive ok###')
except Exception as _e:
    print('###STEP load-permissive error### %s: %s' % (type(_e).__name__, _e))
    raise

# ── dry-permissive · Dry-run: CreateKeyPair ──
try:
    r_dry_permissive = c.dry_run('CreateKeyPair', algorithm='ML_DSA_65')
    print(f'  dry-run: {r_dry_permissive.get("Kind")} ({r_dry_permissive.get("Reason")})')
    print('###STEP dry-permissive ok###')
except Exception as _e:
    print('###STEP dry-permissive error### %s: %s' % (type(_e).__name__, _e))
    raise

# ── load-cnsa · Load policy: cnsa-2.0.yaml ──
try:
    from pyodide.http import pyfetch
    _resp = await pyfetch('/kmip-policies/cnsa-2.0.yaml')
    _yaml = await _resp.string()
    r_load_cnsa = c.load_policy(_yaml)
    if not r_load_cnsa.ok: raise RuntimeError(r_load_cnsa.message or 'LoadPolicy failed')
    print('  policy loaded: cnsa-2.0.yaml')
    print('###STEP load-cnsa ok###')
except Exception as _e:
    print('###STEP load-cnsa error### %s: %s' % (type(_e).__name__, _e))
    raise

# ── dry-cnsa · Dry-run: CreateKeyPair ──
try:
    r_dry_cnsa = c.dry_run('CreateKeyPair', algorithm='ML_DSA_65')
    print(f'  dry-run: {r_dry_cnsa.get("Kind")} ({r_dry_cnsa.get("Reason")})')
    print('###STEP dry-cnsa ok###')
except Exception as _e:
    print('###STEP dry-cnsa error### %s: %s' % (type(_e).__name__, _e))
    raise
"
`;
