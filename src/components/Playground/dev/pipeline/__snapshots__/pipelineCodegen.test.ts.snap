        except Exception as _e:
            print('###STEP t3 detail### ' + json.dumps({'kind': 'error', 'excType': type(_e).__name__, 'message': str(_e), 'traceback': traceback.format_exc()}))
            print('###STEP t3 error### %s: %s' % (type(_e).__name__, _e))
            raise

        # ── t4 · ML-DSA-65 · generate ──
        try:
            pub_t4, priv_t4 = s.generate_ml_dsa(p11.CKP_ML_DSA_65, token=True)
            print('%s keypair · pub=%d priv=%d' % ('ML-DSA-65', pub_t4, priv_t4))
            print('###STEP t4 detail### ' + json.dumps({'kind': 'output', 'fields': []}))
            print('###STEP t4 ok###')
        except Exception as _e:
            print('###STEP t4 detail### ' + json.dumps({'kind': 'error', 'excType': type(_e).__name__, 'message': str(_e), 'traceback': traceback.format_exc()}))
            print('###STEP t4 error### %s: %s' % (type(_e).__name__, _e))
            raise

        # ── t5 · ML-DSA-65 · sign ──
        try:
            result_t5 = s.sign(priv_t4, pipeline_input, p11.CKM_ML_DSA)
            print('%s signature · %d B' % ('ML-DSA-65', len(result_t5)))
            print('###STEP t5 detail### ' + json.dumps({'kind': 'output', 'fields': [{'name': 'signature', 'hex': (result_t5).hex(), 'bytesLen': len(result_t5)}]}))
            print('###STEP t5 ok###')
        except Exception as _e:
            print('###STEP t5 detail### ' + json.dumps({'kind': 'error', 'excType': type(_e).__name__, 'message': str(_e), 'traceback': traceback.format_exc()}))
            print('###STEP t5 error### %s: %s' % (type(_e).__name__, _e))
            raise

    finally:
        s.logout()
        s.close()"
`;
