            print('###STEP t3 detail### ' + json.dumps({'kind': 'error', 'excType': type(_e).__name__, 'message': str(_e), 'traceback': traceback.format_exc()}))
            print('###STEP t3 error### %s: %s' % (type(_e).__name__, _e))
            raise

        # ── t4 · ML-DSA-65 · sign ──
        try:
            result_t4 = s.sign(priv_t1, result_t3, p11.CKM_ML_DSA)
            print('%s signature · %d B' % ('ML-DSA-65', len(result_t4)))
            print('###STEP t4 detail### ' + json.dumps({'kind': 'output', 'fields': [{'name': 'signature', 'hex': (result_t4).hex(), 'bytesLen': len(result_t4)}]}))
            print('###STEP t4 ok###')
