import json
import traceback
import p11
from p11 import Module

PIN = os.environ.get('PKCS11_PIN', '1234')
pipeline_input = b'pqctoday sandbox payload'

with Module() as hsm:
    print('PKCS#11 interface · v%d.%d' % hsm.interface_version)
    s = hsm.open_session(pin=PIN)
    try:
        # ── t1 · SLH-DSA-128s · import ──
        try:
            pub_template_t1 = [
                (p11.CKA_CLASS, p11.CKO_PUBLIC_KEY),
                (p11.CKA_KEY_TYPE, p11.CKK_SLH_DSA),
                (p11.CKA_VERIFY, True),
                (p11.CKA_PARAMETER_SET, p11.CKP_SLH_DSA_SHA2_128S),
                (p11.CKA_VALUE, bytes.fromhex('DB30F66D17E197683997000BC98342AF9B0862379CA9F32EDB1A2EF3A9262207')),
                (p11.CKA_TOKEN, True),
            ]
            pub_t1 = s.create_object(pub_template_t1)
            print('%s imported (public) · pub=%d' % ('SLH-DSA-128s', pub_t1))
            print('###STEP t1 detail### ' + json.dumps({'kind': 'output', 'fields': []}))
            print('###STEP t1 ok###')
        except Exception as _e:
            print('###STEP t1 detail### ' + json.dumps({'kind': 'error', 'excType': type(_e).__name__, 'message': str(_e), 'traceback': traceback.format_exc()}))
            print('###STEP t1 error### %s: %s' % (type(_e).__name__, _e))
            raise

        # ── t2 · SLH-DSA-128s · verify ──
        try:
            result_t2 = s.verify(pub_t1, bytes.fromhex('20'), bytes.fromhex(''), p11.CKM_SLH_DSA, s.sign_context_params(context=bytes.fromhex('')))
            print('%s verify · %s' % ('SLH-DSA-128s', 'PASS' if result_t2 else 'FAIL'))
            print('###STEP t2 detail### ' + json.dumps({'kind': 'output', 'fields': []}))
            print('###STEP t2 ok###')
        except Exception as _e:
            print('###STEP t2 detail### ' + json.dumps({'kind': 'error', 'excType': type(_e).__name__, 'message': str(_e), 'traceback': traceback.format_exc()}))
            print('###STEP t2 error### %s: %s' % (type(_e).__name__, _e))
            raise

        # ── t3 · ACVP check (verified) · assert ──
        try:
            if not result_t2: raise RuntimeError('ACVP KAT MISMATCH — signature verifies against NIST ACVP SLH-DSA-SHA2-128s sigVer tcId=161 (with context): verify returned False')
            print('  ACVP KAT MATCH: signature verifies against NIST ACVP SLH-DSA-SHA2-128s sigVer tcId=161 (with context)')
            print('###STEP t3 detail### ' + json.dumps({'kind': 'output', 'fields': []}))
