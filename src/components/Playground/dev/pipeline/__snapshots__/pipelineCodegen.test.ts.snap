            print('%s decapsulate · secret=%d B match=%s'
                  % ('ML-KEM-768', len(result_t3), result_t3 == s.value(key_t2)))
            print('###STEP t3 detail### ' + json.dumps({'kind': 'output', 'fields': [{'name': 'shared secret', 'hex': (result_t3).hex(), 'bytesLen': len(result_t3)}]}))
