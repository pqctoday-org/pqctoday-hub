{
 "cleanup": {
  "strip_prefixes": [
   "the ",
   "document ",
   "standard ",
   "spec ",
   "source "
  ],
  "strip_suffixes": [
   " document",
   " standard",
   " now",
   " today",
   " still"
  ]
 },
 "patterns": [
  {
   "id": "successor",
   "query": {
    "relation": "replaced_by",
    "walk": "chain"
   },
   "rx": [
    {
     "src": "^what (?:has |document |standard )?(?:replaced|superseded|succeeded|obsoleted|replaces|supersedes) (?<name>.+)$",
     "field": null
    },
    {
     "src": "^what (?:is|was|are) (?:the )?(?:successor|replacement|newer version|latest version|new version) (?:of|to|for) (?<name>.+)$",
     "field": null
    },
    {
     "src": "^(?:has|was|is|have) (?<name>.+?) (?:been )?(?:replaced|superseded|obsoleted)(?: by anything| by something| yet)?$",
     "field": null
    },
    {
     "src": "^(?<name>.+?) (?:was |has been |is )?(?:replaced|superseded|obsoleted) by what$",
     "field": null
    },
    {
     "src": "^(?:which|what) (?:document|standard|rfc|version) (?:replaced|superseded|replaces|supersedes) (?<name>.+)$",
     "field": null
    },
    {
     "src": "^what is the (?:newer|new|later|latest) (?:document|version|standard|revision) that (?:replaced|superseded|replaces|supersedes) (?<name>.+)$",
     "field": null
    },
    {
     "src": "^(?:tell me |please tell me )?which (?:draft or rfc|rfc or draft|rfc or document|draft|rfc|document) (?:replaced|superseded|obsoleted) (?<name>.+)$",
     "field": null
    }
   ]
  },
  {
   "id": "field",
   "query": {
    "relation": null,
    "walk": "field"
   },
   "rx": [
    {
     "src": "^when (?:was|were) (?<name>.+?) (?:published|released|issued)$",
     "field": "initial_publication_date"
    },
    {
     "src": "^when did (?<name>.+?) (?:come out|appear)$",
     "field": "initial_publication_date"
    },
    {
     "src": "^what is the (?:publication|release) date of (?:the )?(?<name>.+)$",
     "field": "initial_publication_date"
    },
    {
     "src": "^who (?:published|wrote|is the author of|authored) (?:the )?(?<name>.+)$",
     "field": "authors_or_organization"
    },
    {
     "src": "^which organi[sz]ation (?:wrote|published) (?:the )?(?<name>.+)$",
     "field": "authors_or_organization"
    },
    {
     "src": "^what is the (?:pqc |post-quantum )?deadline for (?:the )?(?<name>.+)$",
     "field": "deadline"
    },
    {
     "src": "^when must (?:the )?(?<name>.+?) be met$",
     "field": "deadline"
    },
    {
     "src": "^when is the (?<name>.+?) deadline$",
     "field": "deadline"
    },
    {
     "src": "^(?:who|which body|which authority) enforces (?:the )?(?<name>.+)$",
     "field": "enforcement_body"
    },
    {
     "src": "^does (?:the )?(?<name>.+?) require (?:pqc|post-quantum cryptography|quantum-safe cryptography)$",
     "field": "requires_pqc"
    },
    {
     "src": "^is post-quantum cryptography (?:mandatory|required) under (?:the )?(?<name>.+)$",
     "field": "requires_pqc"
    },
    {
     "src": "^when does (?:the )?(?<name>.+?) (?:start|begin)$",
     "field": "StartYear"
    },
    {
     "src": "^what year is (?:the )?(?<name>.+)$",
     "field": "StartYear"
    },
    {
     "src": "^which organi[sz]ation is behind (?:the )?(?<name>.+)$",
     "field": "OrgName"
    },
    {
     "src": "^who issued (?:the )?(?<name>.+)$",
     "field": "OrgName"
    },
    {
     "src": "^does (?<name>.+?) support (?:pqc|post-quantum cryptography|post-quantum crypto)$",
     "field": "pqc_support"
    },
    {
     "src": "^what (?:post-quantum|pqc) support does (?<name>.+?) have$",
     "field": "pqc_support"
    },
    {
     "src": "^is (?<name>.+?) fips(?: 140-3)? validated$",
     "field": "fips_validated"
    },
    {
     "src": "^does (?<name>.+?) have fips validation$",
     "field": "fips_validated"
    },
    {
     "src": "^what is the latest version of (?<name>.+)$",
     "field": "latest_version"
    },
    {
     "src": "^which version of (?<name>.+?) is current$",
     "field": "latest_version"
    },
    {
     "src": "^how big is (?:the |a |an )?(?<name>.+?) public key$",
     "field": "public_key_bytes"
    },
    {
     "src": "^what is the public key size of (?<name>.+)$",
     "field": "public_key_bytes"
    },
    {
     "src": "^what nist security level is (?<name>.+)$",
     "field": "nist_security_level"
    },
    {
     "src": "^which security category does (?<name>.+?) meet$",
     "field": "nist_security_level"
    },
    {
     "src": "^what does (?<name>.+?) do$",
     "field": "Role"
    },
    {
     "src": "^which standard specifies (?<name>.+)$",
     "field": "fips_standard"
    },
    {
     "src": "^what is the standard for (?<name>.+)$",
     "field": "fips_standard"
    }
   ]
  },
  {
   "id": "cites",
   "query": {
    "relation": "cites",
    "walk": "members"
   },
   "rx": [
    {
     "src": "^which documents does (?:the )?(?<name>.+?) cite$",
     "field": null
    },
    {
     "src": "^what standards does (?:the )?(?<name>.+?) reference$",
     "field": null
    }
   ]
  },
  {
   "id": "steps",
   "query": {
    "relation": null,
    "walk": "list_field",
    "field": "steps"
   },
   "rx": [
    {
     "src": "^which workshop steps does (?:the )?(?<name>.+?) have$",
     "field": null
    },
    {
     "src": "^what are the hands-on steps in (?:the )?(?<name>.+)$",
     "field": null
    }
   ]
  },
  {
   "id": "define",
   "query": {
    "relation": null,
    "walk": "none"
   },
   "rx": [
    {
     "src": "^(?:what is|what are|who is|tell me about|explain|describe|what does) (?:the )?(?<name>.+?)(?: (?<typeword>module|tool|lesson|section|use case|sector|algorithm|standard))?(?: mean| about| do)?$",
     "field": null
    },
    {
     "src": "^define (?:the )?(?<name>.+)$",
     "field": null
    }
   ]
  },
  {
   "id": "locate",
   "query": {
    "relation": "taught_in",
    "walk": "members",
    "records_answer_themselves": [
     "section",
     "module"
    ]
   },
   "rx": [
    {
     "src": "^where can i learn about (?:the )?(?<name>.+)$",
     "field": null
    },
    {
     "src": "^which (?:learn )?(?:modules|lessons) (?:cover|teach) (?:the )?(?<name>.+)$",
     "field": null
    },
    {
     "src": "^which section explains (?:the )?(?<name>.+)$",
     "field": null
    },
    {
     "src": "^show me the lesson on (?:the )?(?<name>.+)$",
     "field": null
    }
   ]
  }
 ],
