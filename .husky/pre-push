# pre-push — the LOCAL gate. Everything that is editorial, style-only, or needs
# this machine (sibling checkouts, evidence caches, the full unit suite) runs
# here; GitHub's `checks`/`test`/`gate-cacp` jobs carry only what must be
# proven on a clean runner. The split is written down in GATES.md; a
# check runs in exactly one of the two places.
# Bypass with `git push --no-verify` for an intentional WIP push — knowingly,
# not as a habit.
set -e

# Skip in CI — the GitHub jobs run their own steps.
[ -n "$CI" ] && exit 0

# Every file a workflow step will execute must actually be IN the repository.
# ADDED 2026-08-10, after this failed for the FOURTH time. `.gitignore` has a
# blanket `scripts/*`, and `git add` on an ignored path is a silent no-op — so a
# commit can add a ci.yml step plus a package.json entry with no file behind
# them, stay green on every local run, and fail in CI with ERR_MODULE_NOT_FOUND
# naming a file the author can see in their own tree. Prior occurrences:
# 2026-07-10 (validators), 2026-08-02 (role-board CTAs), 2026-08-09 (role-board
# coverage), 2026-08-10 (the three B+ remediation gates).
# Deliberately here and NOT in ci.yml: a CI step that checks whether CI's own
# files are present can only run once they are. Runs in about a second, so it
# runs on every push, receipt or not.
npm run audit:ci-workflow-files

# Trust-engine artifact signatures. Runs the public verify-attestations.ts
# (tracked, no dependency on the private signer). Skips silently when no .sig
# files exist (early-bootstrap state). Also a CI step — the one deliberate
# overlap, because a signature check is cheap here and a security gate there.
# Bypass with `git push --no-verify` if you intentionally rotated keys and the
# new signatures haven't landed yet.
if [ -f public/data/revisions.jsonl.sig ] || [ -f public/data/rag-corpus.json.sig ]; then
  npx tsx scripts/ci/verify-attestations.ts
fi

# Gate receipt. `npm run gate:release` (and this hook, below) write
# `.gate-ok-<short HEAD sha>` at the repo root ONLY when every step passed. If
# that receipt exists for the commit being pushed and is newer than the commit
# itself, the heavy gate already ran on exactly this commit — skip it, so a
# developer who just ran gate:release does not pay twice. Any new commit (or
# amend) changes the sha, so a stale receipt can never cover new work.
# Receipts are gitignored (.gate-ok-*) and harmless to leave around.
HEAD_SHA=$(git rev-parse --short HEAD)
RECEIPT=".gate-ok-$HEAD_SHA"
if [ -f "$RECEIPT" ]; then
  RECEIPT_TIME=$(stat -f %m "$RECEIPT" 2>/dev/null || stat -c %Y "$RECEIPT")
  COMMIT_TIME=$(git log -1 --format=%ct HEAD)
  if [ "$RECEIPT_TIME" -ge "$COMMIT_TIME" ]; then
    echo "[pre-push] $RECEIPT is newer than HEAD — local gate already passed on this commit, skipping."
    exit 0
  fi
fi

# The local gate: format, lint, the data audits, the FULL unified validator
# (only TP-1/MP-2 excluded — they verify on-disk proof files that exist only
# after a manual download run), the editorial audits (revision coverage,
# role boards, persona lens, changelog tags, content freshness, infographics,
# tokens, workshop flows), wasm provenance against the sibling pqctoday-hsm
# checkout, landing counts, CSV copy-forward, and the unit suite. See
# package.json `gate:local` for the exact chain and GATES.md for what
# each step guards.
npm run gate:local

# CACP (crypto-agility control plane) suite — the KMIP policy engine's wasm
# bridge, visual editor, and policy library, plus the *.local.test.ts drift
# guards (catalog ↔ Rust-grammar, dual-form policy parity, sim ↔ engine
# parity) and the narrow cacp-kmip wasm-provenance check. Some of those guards
# need a sibling ../pqctoday-hsm checkout — see TESTING.md's CACP section.
# Also a GitHub job (`gate-cacp`, against a sparse hsm clone); here it runs
# against the real sibling, which is the only place the full drift guards can.
npm run gate:cacp

# Everything passed on this exact commit — write the receipt (see above).
npm run gate:receipt
