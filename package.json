{
  "name": "pqctoday-hub",
  "private": true,
  "version": "4.153.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,cjs,mjs}": [
      "eslint --fix --no-error-on-unmatched-pattern",
      "prettier --write"
    ],
    "**/*.{json,md,css,html}": "prettier --write",
    "!(**/archive/**)*.csv": "perl -pi -e 's/\\r$//'"
  },
  "scripts": {
    "gen:timeline-facts": "node scripts/gen-timeline-facts.mjs",
    "gen:timeline-facts:check": "node scripts/gen-timeline-facts.mjs --check",
    "release:freeze": "tsx scripts/release-freeze.ts",
    "gen:acvp-native-constants": "tsx scripts/gen-acvp-native-constants.ts",
    "gen:acvp-native-constants:check": "tsx scripts/gen-acvp-native-constants.ts --check",
    "acvp:xplat:wasm": "tsx scripts/acvp-xplat-wasm.ts",
    "acvp:xplat:compare": "tsx scripts/acvp-xplat-compare.ts",
    "acvp:subset-reproduce": "python3 scripts/acvp/subset_reproduce.py --all",
    "acvp:source-check": "tsx scripts/acvp/record-source-checks.ts",
    "acvp:subset-reproduce:offline": "python3 scripts/acvp/subset_reproduce.py --all --offline",
    "acvp:crosscheck:hkdf": "python3 scripts/acvp/crosscheck_hkdf_fixedinfo.py",
    "acvp:crosscheck:kbkdf": "python3 scripts/acvp/crosscheck_kbkdf_segments.py",
    "acvp:crosscheck:sha-mct": "python3 scripts/acvp/crosscheck_sha_mct.py",
    "acvp:crosscheck:aescbc-mct": "python3 scripts/acvp/crosscheck_aescbc_mct.py",
    "acvp:crosschecks": "npm run acvp:crosscheck:hkdf && npm run acvp:crosscheck:kbkdf && npm run acvp:crosscheck:sha-mct && npm run acvp:crosscheck:aescbc-mct",
    "gen:landing-counts": "node scripts/gen-landing-counts.mjs",
    "gen:landing-counts:check": "node scripts/gen-landing-counts.mjs --check",
    "gen:sbom-versions": "tsx scripts/gen-sbom-versions.ts",
    "gen:sbom-versions:check": "tsx scripts/gen-sbom-versions.ts --check",
    "check:sbom-production": "tsx scripts/sbom/check-production.ts",
    "sbom:refresh-crate-licenses": "tsx scripts/sbom/refresh-crate-licenses.ts",
    "sbom:snapshot-bundle": "SBOM_BUNDLE_UPDATE=1 NODE_OPTIONS=--max-old-space-size=10240 vite build --outDir node_modules/.tmp/sbom-snapshot-dist --emptyOutDir",
    "check:sbom-bundle": "tsx scripts/sbom/check-bundle.ts",
    "predev": "npm run gen:timeline-facts && npm run gen:landing-counts && npm run gen:sbom-versions && npm run generate:role-board-content && npm run generate:data-filenames && npm run sync:pyodide-runtime && npm run sync:pyodide-shims && npm run build:monaco-worker && cp -r node_modules/@oqs/liboqs-js/dist public/dist && mkdir -p public/wasm && (test -f public/wasm/softhsm.wasm || cp node_modules/@pqctoday/softhsm-wasm/wasm/softhsm.js node_modules/@pqctoday/softhsm-wasm/wasm/softhsm.wasm public/wasm/)",
    "prebuild": "npm run gen:timeline-facts && npm run gen:landing-counts && npm run gen:sbom-versions && npm run sync:pyodide-runtime && npm run sync:pyodide-shims && npm run build:monaco-worker",
    "dev": "vite",
    "build": "npm run build:sdk && rm -rf public/dist && cp -r node_modules/@oqs/liboqs-js/dist public/dist && mkdir -p public/wasm && (test -f public/wasm/softhsm.wasm || cp node_modules/@pqctoday/softhsm-wasm/wasm/softhsm.js node_modules/@pqctoday/softhsm-wasm/wasm/softhsm.wasm public/wasm/) && npm run generate-oscal && npm run generate-cbom && npm run gen:tool-route-meta && npm run generate:sitemap && npm run generate:role-board-content && npm run generate:data-filenames && tsc -b && NODE_OPTIONS=--max-old-space-size=8192 vite build && NODE_OPTIONS=--max-old-space-size=8192 npm run prerender && tsx scripts/ci/make-404.ts && npm run gate:precache && npm run gate:tla-imports",
    "build:sdk": "npx esbuild src/embed/sdk.ts --bundle --outfile=public/embed/sdk.js --format=esm --target=es2020 --minify",
    "build:monaco-worker": "mkdir -p public/monaco && npx esbuild node_modules/monaco-editor/esm/vs/editor/editor.worker.js --bundle --outfile=public/monaco/editor.worker.js --format=iife --target=es2020",
    "sync:pyodide-shims": "mkdir -p public/pyodide-shims/p11 public/pyodide-shims/pqctoday_kmip && cp src/services/python/pyodide/shims/p11/__init__.py src/services/python/pyodide/shims/p11/_constants.py public/pyodide-shims/p11/ && cp src/services/python/pyodide/shims/pqctoday_kmip/__init__.py public/pyodide-shims/pqctoday_kmip/",
    "sync:pyodide-runtime": "mkdir -p public/pyodide && cp node_modules/pyodide/ffi.d.ts node_modules/pyodide/pyodide-lock.json node_modules/pyodide/pyodide.asm.js node_modules/pyodide/pyodide.asm.wasm node_modules/pyodide/pyodide.d.ts node_modules/pyodide/pyodide.mjs node_modules/pyodide/python_stdlib.zip public/pyodide/",
    "lint": "eslint --no-error-on-unmatched-pattern src e2e *.ts *.js *.cjs",
    "gate:pkcs11": "npm run test -- src/components/Playground/hsm src/components/Playground/tabs src/components/Playground/dev src/components/Playground/learnkit src/components/Playground/HsmPlayground.test.tsx src/wasm/softhsm && npm run test:local -- src/components/Playground/hsm src/components/Playground/dev",
    "gate:cacp": "npm run test -- src/components/Playground/kmip src/wasm/kmip && npm run test:local:cacp && npm run sync:wasm:check:cacp-kmip",
    "preview": "vite preview",
    "pretest": "npm run gen:sbom-versions",
    "test": "vitest run",
    "test:local": "vitest run --config vitest.local.config.ts",
    "test:nightly": "vitest run --config vitest.nightly.config.ts",
    "test:local:cacp": "vitest run --config vitest.local.config.ts src/components/Playground/kmip src/wasm/kmip",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test --project=chromium --timeout=180000",
    "pretest:e2e:smoke": "npm run build",
    "test:e2e:smoke": "playwright test --project=smoke",
    "test:e2e:dev": "E2E_SERVER=dev playwright test --project=chromium",
    "test:e2e:cacp-visual": "E2E_SERVER=dev playwright test --project=local e2e/playground-cacp-visual.local.spec.ts",
    "test:e2e:cacp-local": "E2E_SERVER=dev playwright test --project=local e2e/cacp-policy-scenarios.local.spec.ts e2e/cacp-sim-fidelity.local.spec.ts e2e/cacp-engine-trace.local.spec.ts e2e/cacp-migration.local.spec.ts e2e/cacp-scenario-picker.local.spec.ts e2e/playground-cacp-visual.local.spec.ts",
    "test:e2e:ci-smoke": "playwright test --project=smoke",
    "test:e2e:ci-full": "playwright test --project=chromium --timeout=180000",
    "test:a11y": "playwright test e2e/accessibility.spec.ts --project=chromium",
    "test:external": "playwright test e2e/production.spec.ts e2e/compliance-sources.spec.ts",
    "coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky; git config merge.ours.driver true || true",
    "check:version-bumps": "tsx scripts/ci/check-tool-version-bump.ts && tsx scripts/ci/check-module-version-bump.ts",
    "gate:local": "npm run format:check && npm run lint && npm run check:version-bumps && npm run audit:matrix-refs && npm run audit:role-board-drift && npm run gen:timeline-facts:check && npm run gen:landing-counts:check && npm run generate:data-filenames:check && npm run gen:sbom-versions:check && npm run gen:tool-route-meta:check && npm run audit:test-reachability && npm run test && npm run test:local && npm run gate:receipt",
    "gate:prepush": "npm run format:check && npm run lint && npm run check:version-bumps && npm run audit:matrix-refs && npm run audit:role-board-drift && npm run gen:timeline-facts:check && npm run gen:landing-counts:check && npm run generate:data-filenames:check && npm run gen:sbom-versions:check && npm run gen:tool-route-meta:check && npm run audit:test-reachability && npm run gate:receipt",
    "gate:release-local": "npm run test:local",
    "gate:e2e": "npm run build && npm run check:sbom-bundle && npm run test:e2e:ci-full",
    "test:e2e:local-tier": "E2E_SERVER=dev playwright test --project=local",
    "gate:release": "npm run gate:local && npm run gate:e2e && npm run test:e2e:local-tier && npm run gate:receipt",
    "gate:receipt": "touch .gate-ok-$(git rev-parse --short HEAD)",
    "audit:matrix-refs": "tsx scripts/audit-matrix-refs.ts",
    "audit:ci-workflow-files": "tsx scripts/audit-ci-workflow-files.ts",
    "build:openssl-wasm": "bash build-wasm.sh",
    "generate-cbom": "tsx scripts/generate-cbom.ts",
    "generate-cbom:dry": "tsx scripts/generate-cbom.ts --dry-run",
    "generate-oscal": "tsx scripts/generate-oscal.ts",
    "generate-oscal:dry": "tsx scripts/generate-oscal.ts --dry-run",
    "prerender": "tsx scripts/prerender.ts",
    "generate:sitemap": "tsx scripts/generate-sitemap.ts",
    "generate:role-board-content": "tsx scripts/generate-role-board-content.ts",
    "generate:data-filenames": "tsx scripts/generate-data-filenames.ts",
    "generate:data-filenames:check": "tsx scripts/generate-data-filenames.ts --check",
    "audit:role-board-drift": "tsx scripts/generate-role-board-content.ts --check",
    "generate:sitemap:check": "tsx scripts/generate-sitemap.ts --check",
    "gen:tool-route-meta": "TSX_TSCONFIG_PATH=tsconfig.app.json tsx scripts/ci/gen-tool-route-meta.ts",
    "gen:tool-route-meta:check": "TSX_TSCONFIG_PATH=tsconfig.app.json tsx scripts/ci/gen-tool-route-meta.ts --check",
    "check:seo-production": "tsx scripts/ci/check-live-seo.ts",
    "evaluate:mlx-harness": "vitest run --config vitest.local.config.ts src/services/chat/evaluation/mlxHarness.local.test.ts --reporter=verbose",
    "evaluate:local-models": "E2E_SERVER=dev RUN_LOCAL_MODEL_COMPARISON=1 playwright test --project=local e2e/local-model-comparison.local.spec.ts",
    "evaluate:cloud-models": "E2E_SERVER=dev playwright test --project=local e2e/cloud-model-comparison.local.spec.ts",
    "sync:wasm:check": "tsx scripts/ci/check-wasm-provenance.ts --check",
    "sync:wasm:check:cacp-kmip": "tsx scripts/ci/check-wasm-provenance.ts --check --only=cacp-kmip",
    "sync:wasm:report": "tsx scripts/ci/check-wasm-provenance.ts",
    "verify-attestations": "tsx scripts/ci/verify-attestations.ts",
    "gate:precache": "tsx scripts/ci/precache-budget.ts",
    "gate:tla-imports": "tsx scripts/ci/check-tla-eager-imports.ts",
    "audit:deps": "tsx scripts/ci/audit-gate.ts",
    "audit:test-reachability": "tsx scripts/ci/check-test-reachability.ts",
    "audit:vector-reachability": "tsx scripts/ci/check-vector-reachability.ts"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "esbuild": "^0.28.1",
    "serialize-javascript": ">=7.0.3",
    "uuid": "^14.0.0",
    "sharp": "^0.35.5"
